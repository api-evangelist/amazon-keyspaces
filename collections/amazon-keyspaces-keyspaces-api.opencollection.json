            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://cassandra.us-east-1.amazonaws.com/keyspaces/:keyspaceName",
            "params": [
              {
                "name": "keyspaceName",
                "value": "",
                "type": "path",
                "description": "The name of the keyspace."
              }
            ]
